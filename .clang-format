BasedOnStyle: LLVM
ColumnLimit: 120

IndentWidth: 4
BinPackArguments: false
BinPackParameters: false
Cpp11BracedListStyle: true
AlignArrayOfStructures: Left 

SortIncludes: true
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^<[^"]*>'        # system headers
    Priority: 1
  - Regex: '^<codeframe>'    # external lib
    Priority: 2
  - Regex: '.*'              # everything else (project headers)
    Priority: 3